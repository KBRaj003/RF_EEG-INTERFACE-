<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
        <uses-permission android:name="android.permission.CAMERA" />
<application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="RF Physiology Research" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>

        <activity
            android:name="org.kbraj003.rfphysiology.CameraTelemetryActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:label="Camera + LTE Telemetry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
</application>
</manifest>
